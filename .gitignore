# Secrets and local config — never commit these.
.env
.env.*
!.env.example

# Private runtime data (real mailbox content, real resume, tokens, DBs).
data/private/
*.db
*.sqlite
*.sqlite3

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Generated eval output (baseline is committed, fresh runs are not).
evals/metrics.json
evals/report.html

# Record/replay captures may contain live model output.
data/records/

# OS / editor
.DS_Store
.idea/
.vscode/

# Test / linter caches
.pytest_cache/
.ruff_cache/
