
# --- Core ---
DATABASE_URL=sqlite:///./data/jobguard.local.db
OWNER_EMAIL=owner@example.com
DEMO_MODE=false

# --- LLM (OpenAI-compatible: Groq / OpenRouter / Ollama) ---
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_MAX_TOKENS_PER_RUN=20000
LLM_MAX_REQUESTS_PER_RUN=100
LLM_MAX_REQUESTS_PER_MIN=20
LLM_MAX_TOKENS_PER_MIN=8000
LLM_TOP_N_PER_RUN=30
LLM_CHEAP_SCORE_MIN=15
LLM_WORKERS=2
LLM_MAX_INPUT_CHARS=3000
LLM_REPLAY_PATH=

# --- Digest sending (SEPARATE credentials from Gmail reading) ---
SENDER_SMTP_HOST=
SENDER_SMTP_PORT=587
SENDER_SMTP_USER=
SENDER_SMTP_PASSWORD=
SENDER_FROM_ADDRESS=
SENDER_MAX_PER_DAY=20
# Friends who also get the morning digest (comma-separated). Each gets a
# separate email with the job list only: no resume notes, no approvals.
DIGEST_RECIPIENTS=
APPROVE_BASE_URL=http://localhost:8000
DIGEST_BEST_SCORE=75
DIGEST_URGENT_HOURS=48
# Whole words the job TITLE must contain (empty = built-in developer list).
PREFILTER_KEYWORDS=
PREFILTER_SENDERS=linkedin,indeed,naukri,internshala,unstop,glassdoor,hirist,instahyre,wellfound,cutshort,foundit,apna
# india = India + India-compatible remote + no-location jobs; any = no location gate.
LOCATION_SCOPE=india
# intern = only internship/apprentice/trainee titles (drops SDE 2/3, senior, full-time).
ROLE_LEVEL=intern
# Your graduation batch: postings that name only other batches are dropped (0 = off).
GRAD_YEAR=2027
DIGEST_MAX_ITEMS=60
BOARDS_CONFIG_PATH=data/boards.yaml
RSS_FEEDS=
# Optional India-wide aggregator (free key at developer.adzuna.com):
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_QUERIES=software engineer intern,sde intern,software developer intern,developer intern,software engineer fresher,backend developer,frontend developer,full stack developer
RESUME_PATH=data/private/resume.yaml
PROFILE_PATH=data/profile.yaml

# --- Gmail reading (readonly OAuth). See README for setup. ---
# Paths to files under data/private/ (gitignored), NOT the secret values.
GMAIL_CLIENT_SECRET=data/private/gmail_client_secret.json
GMAIL_TOKEN_PATH=data/private/gmail_token.json
# Empty = built-in job-mail search (alert senders + hiring subjects).
GMAIL_QUERY=
GMAIL_LOOKBACK_DAYS=3
GMAIL_MAX_MESSAGES=300
# IMAP read-only fallback (optional):
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD_FILE=data/private/imap_password.txt
# The IMAP app password itself lives in that file, never here.

# --- Dashboard sign-in: Clerk (recommended) ---
# Create an app at dashboard.clerk.com -> API keys. With the publishable key
# set, Clerk replaces the password login below.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may enter (default: OWNER_EMAIL, checked via CLERK_SECRET_KEY).
CLERK_ALLOWED_EMAILS=
# Or allow by Clerk user id (works without the secret key).
CLERK_ALLOWED_USER_IDS=
# Deployed origin(s), e.g. https://jobguard.onrender.com (empty = not checked).
CLERK_AUTHORIZED_PARTIES=

# --- Dashboard password login (fallback when Clerk is not configured) ---
DASHBOARD_USERNAME=
# SHA-256 hex of the dashboard password (generate with:
# python -c "from jobguard.web.auth import hash_password; print(hash_password('...'))").
# The password itself and the secret key live in data/private/, never here.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SECRET_KEY=
