
# --- Core ---
DATABASE_URL=sqlite:///./data/jobguard.local.db
OWNER_EMAIL=owner@example.com
DEMO_MODE=false

# --- LLM (OpenAI-compatible: Groq / OpenRouter / Ollama) ---
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS_PER_RUN=20000

# --- Digest sending (SEPARATE credentials from Gmail reading) ---
SENDER_SMTP_HOST=
SENDER_SMTP_PORT=587
SENDER_SMTP_USER=
SENDER_SMTP_PASSWORD=
SENDER_FROM_ADDRESS=
SENDER_MAX_PER_DAY=20
APPROVE_BASE_URL=http://localhost:8000
DIGEST_BEST_SCORE=75
DIGEST_URGENT_HOURS=48
PREFILTER_KEYWORDS=sde,software,developer,engineer,intern,backend,frontend,full-stack,full stack,devops,data,ml,android,ios,qa,sdet
PREFILTER_SENDERS=linkedin,indeed,naukri,internshala,unstop,glassdoor
BOARDS_CONFIG_PATH=data/boards.yaml
RSS_FEEDS=
LLM_PROVIDER=fake
LLM_CALL_GAP_S=2.0
LLM_REPLAY_PATH=
RESUME_PATH=data/private/resume.yaml
PROFILE_PATH=data/profile.yaml

# --- Gmail reading (readonly OAuth). See README for setup. ---
# Paths to files under data/private/ (gitignored), NOT the secret values.
GMAIL_CLIENT_SECRET=data/private/gmail_client_secret.json
GMAIL_TOKEN_PATH=data/private/gmail_token.json
# IMAP read-only fallback (optional):
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD_FILE=data/private/imap_password.txt
# The IMAP app password itself lives in that file, never here.

# --- Dashboard (Phase 6) ---
DASHBOARD_USERNAME=
# SHA-256 hex of the dashboard password (generate with:
# python -c "from jobguard.web.auth import hash_password; print(hash_password('...'))").
# The password itself and the secret key live in data/private/, never here.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SECRET_KEY=
